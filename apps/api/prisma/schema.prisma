// Fazo Group — “KIA SONET MENIKI” aksiya tizimi
//
// Kupon faqat kassir chiqargan bir martalik QR (Voucher) va taklif bonusi orqali beriladi.
// Qoidalar:
//  - Hamma vaqt UTC'da saqlanadi (timestamptz). Ko'rsatish — Asia/Tashkent.
//  - Pul — Decimal(14,2), so'mda.
//  - Telefon — +998XXXXXXXXX.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Campaign {
  id                 Int       @id @default(autoincrement())
  name               String
  startsAt           DateTime  @db.Timestamptz(3)
  endsAt             DateTime? @db.Timestamptz(3)
  receiptWindowHours Int       @default(72)
  rulesText          String    @default("")
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)

  coupons Coupon[]

  @@map("campaigns")
}

model Branch {
  id            Int       @id @default(autoincrement())
  name          String
  brand         String?
  isActive      Boolean   @default(true)
  minSum        Decimal   @default(100000) @db.Decimal(14, 2)
  couponPrice   Decimal   @default(100000) @db.Decimal(14, 2)
  maxPerReceipt Int       @default(10)
  // Chekdagi logo: admin yuklaydi, brauzerda oq-qora qilinadi (termoprinter faqat qora chiqaradi).
  // Asl rasm qayta sozlash uchun saqlanadi; ro'yxatlarda bu baytlar qaytarilmaydi
  logoEnabled   Boolean   @default(false)
  logoOriginal  Bytes?
  logoPrint     Bytes?
  // Oq-qora chegarasi (0–255) va ranglarni almashtirish (to'q fonli logolar uchun)
  logoThreshold Int       @default(160)
  logoInvert    Boolean   @default(false)
  logoUpdatedAt DateTime? @db.Timestamptz(3)
  // Chek matnlari: { title, subtitle, hint, footer } — bo'sh bo'lsa standart matn
  receiptTexts  Json?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  receipts  Receipt[]
  vouchers  Voucher[]
  admins    AdminUser[]
  terminals Terminal[]

  @@map("branches")
}

/**
 * Filialdagi kassa qurilmasi: kassir shu tugmani bossa, QR shu usulda chiqadi
 */
model Terminal {
  id        Int            @id @default(autoincrement())
  branchId  Int
  name      String
  output    TerminalOutput @default(PRINT_80)
  isActive  Boolean        @default(true)
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now()) @db.Timestamptz(3)

  branch   Branch    @relation(fields: [branchId], references: [id])
  vouchers Voucher[]

  @@index([branchId])
  @@map("terminals")
}

model Participant {
  id              Int       @id @default(autoincrement())
  tgId            BigInt    @unique
  // Kontakt yuborilguncha bo'sh
  phone           String?   @unique
  firstName       String?
  lastName        String?
  username        String?
  languageCode    String?
  refCode         String    @unique
  referredById    Int?
  // /start payload: src_<tag> yoki ref_<code> — xom holda
  startPayload    String?
  // Ro'yxatdan o'tmasdan skanerlangan vaucher — ro'yxatdan o'tgach avtomatik qo'llanadi
  pendingVoucher  String?
  source          String?
  isStaff         Boolean   @default(false)
  isBlocked       Boolean   @default(false)
  // Rozilik: raqam yuborilganda (qoidalar o'sha xabarda ko'rsatiladi). Qaysi qoidalar
  // matniga rozi bo'lgani — rulesText'ning sha256 boshi (keyin matn o'zgarsa ham isbot)
  rulesAcceptedAt DateTime? @db.Timestamptz(3)
  rulesVersion    String?
  // Shu do'st (taklif qilingan) uchun taklif bonusi ko'rib chiqilgan vaqt —
  // bitta do'st uchun bonus faqat bir marta
  referralBonusAt DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  referredBy Participant?  @relation("Referral", fields: [referredById], references: [id])
  referrals  Participant[] @relation("Referral")
  receipts   Receipt[]     @relation("ReceiptOwner")
  coupons    Coupon[]
  vouchers   Voucher[]

  @@map("participants")
}

enum ReceiptSource {
  QR
  PHOTO
  MANUAL
  // Kassir chiqargan vaucher QR'i orqali (asosiy oqim, 2026-10-14 dan)
  VOUCHER
  // Taklif bonusi: taklif qilingan do'st birinchi xaridini qilganda (summasiz yozuv)
  REFERRAL
}

enum ReceiptStatus {
  PENDING
  APPROVED
  BELOW_MIN
  REJECTED
  NOT_FOUND
  NEEDS_REVIEW
}

/**
 * Kupon berilgan yozuv: kassa QR'i skanerlanganda (VOUCHER, receiptNumber "V<vaucher>")
 * yoki taklif bonusi (REFERRAL, "R<do'st>"). Eski fiskal chek maydonlari olib tashlangan.
 */
model Receipt {
  id            Int           @id @default(autoincrement())
  participantId Int
  receiptNumber String?
  fiscalAt      DateTime?     @db.Timestamptz(3)
  source        ReceiptSource
  status        ReceiptStatus @default(PENDING)
  amount        Decimal?      @db.Decimal(14, 2)
  branchId      Int?
  couponsCount  Int           @default(0)
  // Vaucherni chiqargan kassir
  reviewedById  Int?
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  decidedAt     DateTime?     @db.Timestamptz(3)

  participant Participant @relation("ReceiptOwner", fields: [participantId], references: [id])
  branch      Branch?     @relation(fields: [branchId], references: [id])
  reviewedBy  AdminUser?  @relation(fields: [reviewedById], references: [id])
  coupons     Coupon[]
  voucher     Voucher?

  @@index([status])
  @@index([participantId])
  @@index([createdAt])
  @@map("receipts")
}

model Coupon {
  // Ketma-ket raqam = kupon raqami
  id            Int      @id @default(autoincrement())
  campaignId    Int
  participantId Int
  receiptId     Int
  // Xodim yoki qaytarilgan chek bo'lsa false — o'yinda qatnashmaydi
  eligible      Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  campaign    Campaign    @relation(fields: [campaignId], references: [id])
  participant Participant @relation(fields: [participantId], references: [id])
  receipt     Receipt     @relation(fields: [receiptId], references: [id])

  @@index([participantId])
  @@index([receiptId])
  @@map("coupons")
}

model StaffPhone {
  phone     String   @id
  name      String?
  source    String   @default("CSV")
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@map("staff_phones")
}

enum AdminRole {
  ADMIN
  OPERATOR
  // Faqat "Kassa" sahifasi: o'z filialida vaucher chiqaradi
  CASHIER
  // Filial menejeri: o'z filialining kassasi va vaucherlari
  MANAGER
}

enum TerminalOutput {
  // Termoprinter 80 mm / 58 mm (brauzer bosma oynasi orqali)
  PRINT_80
  PRINT_58
  // Chop etmaydi — QR katta qilib ekranda ko'rsatiladi (Sunmi, planshet)
  SCREEN
}

model AdminUser {
  id           Int       @id @default(autoincrement())
  login        String    @unique
  passwordHash String
  role         AdminRole @default(OPERATOR)
  // Bo'limlarga ruxsatlar (src/admin/permissions.ts). ADMIN uchun e'tiborga olinmaydi — hammasi ochiq
  permissions  String[]  @default([])
  // Xodim biriktirilgan filial: kassa va vaucherlar shu filial bilan cheklanadi
  // (CASHIER va MANAGER uchun majburiy)
  branchId     Int?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  branch            Branch?    @relation(fields: [branchId], references: [id])
  reviewedReceipts  Receipt[]
  auditLogs         AuditLog[]
  issuedVouchers    Voucher[]  @relation("VoucherIssuer")
  cancelledVouchers Voucher[]  @relation("VoucherCanceller")
  revokedVouchers   Voucher[]  @relation("VoucherRevoker")

  @@map("admin_users")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  actorId   Int?
  action    String
  entity    String
  entityId  String?
  data      Json?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  actor AdminUser? @relation(fields: [actorId], references: [id])

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// Kalit-qiymat sozlamalar (taklif bonusi va h.k.)
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("settings")
}

enum VoucherStatus {
  ISSUED
  REDEEMED
  CANCELLED
}

// Kassir chiqargan bir martalik QR. QR'da faqat tasodifiy token bor
// (t.me/<bot>?start=v_<token>) — summa va kupon soni shu yerda, o'zgartirib bo'lmaydi.
model Voucher {
  id              Int           @id @default(autoincrement())
  // crypto.randomBytes(16) base64url — 22 belgi, taxmin qilib bo'lmaydi
  token           String        @unique
  branchId        Int
  amount          Decimal       @db.Decimal(14, 2)
  couponsCount    Int
  // Kassir kiritgan yozuv (tekshiruv uchun; QR telefonga bog'lanmaydi)
  customerName    String?
  customerPhone   String?
  status          VoucherStatus @default(ISSUED)
  issuedById      Int
  issuedAt        DateTime      @default(now()) @db.Timestamptz(3)
  expiresAt       DateTime      @db.Timestamptz(3)
  redeemedById    Int?
  redeemedAt      DateTime?     @db.Timestamptz(3)
  // Skanerlagan Telegram akkaunt — o'sha paytdagi holati muhrlanadi (ishchilar
  // soxta vaucher chiqarib o'zlari olishini aniqlash uchun; profil keyin o'zgarsa ham saqlanadi)
  redeemedPhone   String?
  redeemedTgId    BigInt?
  redeemedName    String?
  // Kassir yozgan raqam skanerlagan raqamdan farq qiladi (bloklamaydi, faqat belgi)
  phoneMismatch   Boolean       @default(false)
  // Skanerlagan odam xodimlar ro'yxatida
  redeemedByStaff Boolean       @default(false)
  receiptId       Int?          @unique
  // Qaysi kassa qurilmasidan chiqarilgan
  terminalId      Int?
  cancelledById   Int?
  cancelledAt     DateTime?     @db.Timestamptz(3)
  cancelReason    String?
  // Skanerlangandan keyin bekor qilingan (firibgarlik): kuponlar o'yindan chiqarilgan,
  // yozuv saqlanadi va tiklash mumkin. Holat REDEEMED bo'lib qoladi
  revokedAt       DateTime?     @db.Timestamptz(3)
  revokedById     Int?
  revokeReason    String?

  branch      Branch       @relation(fields: [branchId], references: [id])
  issuedBy    AdminUser    @relation("VoucherIssuer", fields: [issuedById], references: [id])
  cancelledBy AdminUser?   @relation("VoucherCanceller", fields: [cancelledById], references: [id])
  revokedBy   AdminUser?   @relation("VoucherRevoker", fields: [revokedById], references: [id])
  redeemedBy  Participant? @relation(fields: [redeemedById], references: [id])
  receipt     Receipt?     @relation(fields: [receiptId], references: [id])
  terminal    Terminal?    @relation(fields: [terminalId], references: [id])

  @@index([status])
  @@index([issuedAt])
  @@index([branchId, issuedAt])
  @@index([issuedById, issuedAt])
  @@index([redeemedPhone])
  @@map("vouchers")
}
