# ── Umumiy ────────────────────────────────────────────────────────────────
NODE_ENV=production
# Prod'da compose o'zi beradi: postgresql://fazo:<POSTGRES_PASSWORD>@postgres:5432/fazo_club
DATABASE_URL=postgresql://fazo:fazo@127.0.0.1:4602/fazo_club
POSTGRES_PASSWORD=
PORT=4600

# Mini app va admin panel manzili (HTTPS shart)
PUBLIC_URL=https://club.fazorestaurant.uz

# ── Telegram ──────────────────────────────────────────────────────────────
BOT_TOKEN=
BOT_USERNAME=FazoClub_bot
# webhook (prod) | polling (lokal) | off
BOT_MODE=webhook
# openssl rand -hex 24
BOT_WEBHOOK_SECRET=
# Admin ogohlantirishlari guruhi (guruhda /chatid yozing)
ADMIN_ALERT_CHAT_ID=

# ── Admin panel ───────────────────────────────────────────────────────────
# openssl rand -base64 48
JWT_SECRET=
# Birinchi ishga tushishda shu login bilan ADMIN yaratiladi (seed)
ADMIN_INIT_LOGIN=admin
ADMIN_INIT_PASSWORD=

# Mijozlar uchun aloqa (telefon yoki @username)
SUPPORT_CONTACT=

# Rasm va fayllar
STORAGE_DIR=./storage
